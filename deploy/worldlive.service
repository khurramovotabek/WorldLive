[Unit]
Description=WorldLive (uvicorn: HTTP + WebSockets)
After=network.target

[Service]
User=worldlive
Group=worldlive
WorkingDirectory=/opt/worldlive/app
EnvironmentFile=/opt/worldlive/.env
# one process: the in-memory channel layer lives in it, so every socket of a journey meets there
ExecStart=/opt/worldlive/venv/bin/uvicorn worldlive.asgi:application --host 127.0.0.1 --port 8020 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --ws-ping-interval 25 --no-access-log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
